generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth ────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  EDITOR
  SPONSORSHIP_COORDINATOR
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(EDITOR)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  activity     ActivityLog[]
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  label     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ─── Pages and sections ──────────────────────────────────────────────────

model Page {
  id              String    @id @default(cuid())
  slug            String    @unique // "" for the home page, "programmes", "news", "templates/programme" …
  title           String
  seoTitle        String?
  metaDescription String?
  keywords        String?
  ogImage         String?
  published       Boolean   @default(true)
  isTemplate      Boolean   @default(false) // detail-page templates (programme, news article)
  sections        Section[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Section {
  id         String   @id @default(cuid())
  pageId     String
  page       Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type       String
  label      String?
  order      Int      @default(0)
  visible    Boolean  @default(true)
  background String   @default("white") // white | mist | navy
  anchor     String?
  content    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([pageId, order])
}

// ─── Collections ─────────────────────────────────────────────────────────

model Pillar {
  id     String  @id @default(cuid())
  number String
  title  String
  short  String
  link   String
  icon   String?
  order  Int     @default(0)
}

model Programme {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  pillar      String // teachers | children | families | care | partnerships
  summary     String
  description String // sanitised HTML
  audience    String?
  format      String?
  frequency   String?
  location    String?  @default("Douala, Cameroon")
  delivery    String?  @default("By invitation or partnership")
  status      String?
  coverImage  String?
  coverAlt    String?
  gallery     Json     @default("[]")
  ctaLabel    String?
  ctaLink     String?
  featured    Boolean  @default(false)
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Value {
  id          String @id @default(cuid())
  title       String
  description String
  icon        String @default("Heart")
  order       Int    @default(0)
}

model Milestone {
  id          String  @id @default(cuid())
  period      String
  title       String
  description String
  era         String?
  image       String?
  imageAlt    String?
  showOnHome  Boolean @default(true)
  order       Int     @default(0)
}

model SponsorshipStep {
  id          String @id @default(cuid())
  number      String
  title       String
  description String
  order       Int    @default(0)
}

model NewsArticle {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  publishedAt DateTime @default(now())
  showDate    Boolean  @default(true)
  category    String   @default("News")
  excerpt     String
  coverImage  String?
  coverAlt    String?
  body        String // sanitised HTML
  author      String?
  published   Boolean  @default(true)
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Event {
  id                  String    @id @default(cuid())
  title               String
  startsAt            DateTime
  startTime           String?
  venue               String?
  description         String
  image               String?
  registrationOpen    Boolean   @default(false)
  capacity            Int?
  published           Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Conference {
  id        String   @id @default(cuid())
  title     String
  dateLabel String
  venue     String?
  summary   String
  report    String?
  gallery   Json     @default("[]")
  published Boolean  @default(true)
  order     Int      @default(0)
}

model Resource {
  id          String  @id @default(cuid())
  title       String
  category    String
  description String?
  fileUrl     String?
  published   Boolean @default(true)
  order       Int     @default(0)
}

model TeamMember {
  id        String  @id @default(cuid())
  name      String
  role      String
  group     String // founder | board | foundation | staff
  photo     String?
  bio       String?
  published Boolean @default(true)
  order     Int     @default(0)
}

model Partner {
  id         String  @id @default(cuid())
  name       String
  logo       String?
  website    String?
  type       String?
  showPublic Boolean @default(true)
  order      Int     @default(0)
}

model DonationFund {
  id          String @id @default(cuid())
  title       String
  description String
  icon        String @default("HeartHandshake")
  order       Int    @default(0)
}

model VolunteerArea {
  id          String @id @default(cuid())
  title       String
  description String
  order       Int    @default(0)
}

model PartnershipType {
  id          String @id @default(cuid())
  title       String
  description String
  order       Int    @default(0)
}

model Testimony {
  id       String  @id @default(cuid())
  quote    String
  name     String
  role     String?
  photo    String?
  approved Boolean @default(false)
  order    Int     @default(0)
}

// ─── Settings, media, forms ──────────────────────────────────────────────

model SiteSettings {
  id        Int      @id @default(1)
  data      Json
  updatedAt DateTime @updatedAt
}

model Media {
  id        String   @id @default(cuid())
  url       String
  key       String   @unique
  filename  String
  mimeType  String
  size      Int
  width     Int?
  height    Int?
  alt       String   @default("")
  focalX    Int      @default(50)
  focalY    Int      @default(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model FormDefinition {
  id             String   @id @default(cuid())
  key            String   @unique
  name           String
  restricted     Boolean  @default(false) // child-protection: visible to ADMIN + SPONSORSHIP_COORDINATOR only
  sponsorship    Boolean  @default(false) // visible to SPONSORSHIP_COORDINATOR
  submitLabel    String
  successTitle   String
  successBody    String
  note           String?
  errorMessage   String   @default("We could not send this just now. Please try again, or email us directly at info@iacecglobal.com.")
  recipients     String[]
  autoReply      Boolean  @default(true)
  autoReplySubject String  @default("Thank you for contacting IACEC")
  autoReplyBody  String   @default("Thank you for writing to the Innovation Association for Christian Educators. A member of our team will respond as soon as possible.")
  fields         Json
  updatedAt      DateTime @updatedAt
}

enum SubmissionStatus {
  NEW
  IN_PROGRESS
  DONE
  ARCHIVED
}

model Submission {
  id        String           @id @default(cuid())
  formKey   String
  data      Json
  status    SubmissionStatus @default(NEW)
  notes     String?
  ipHash    String?
  userAgent String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([formKey, status])
  @@index([ipHash, createdAt])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String?
  ipHash    String?
  createdAt DateTime @default(now())
}
