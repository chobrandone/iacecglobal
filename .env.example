# ─── Database ─────────────────────────────────────────────────────────────
# PostgreSQL connection string. On Vercel use the pooled URL from Vercel Postgres / Neon / Supabase.
# For local development you can run `npm run db:local` and use the URL it prints.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/iacec?schema=public"

# ─── Authentication (Auth.js) ─────────────────────────────────────────────
# A long random string. Generate one with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"
# Your public site address (used for canonical URLs, sitemap, emails).
NEXT_PUBLIC_SITE_URL="https://iacecglobal.com"

# ─── First administrator (created by `npm run db:seed`) ───────────────────
ADMIN_EMAIL="admin@iacecglobal.com"
ADMIN_PASSWORD="change-me-to-a-strong-password"
ADMIN_NAME="Administrator"

# ─── Image & file storage (S3-compatible) ─────────────────────────────────
# Leave S3_BUCKET empty in development to store uploads in public/uploads.
# Production (Vercel) needs one of: Cloudflare R2, AWS S3 or Supabase Storage (S3 API).
S3_BUCKET=""
S3_REGION="auto"
# Endpoint for R2 / Supabase, e.g. https://<account-id>.r2.cloudflarestorage.com  (leave empty for AWS S3)
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL that serves the bucket, e.g. https://media.iacecglobal.com  (no trailing slash)
S3_PUBLIC_URL=""

# ─── Email (form notifications and auto-replies) ──────────────────────────
# Sender address, e.g. "IACEC <no-reply@iacecglobal.com>" (the domain must be verified with your provider).
EMAIL_FROM="IACEC <no-reply@iacecglobal.com>"
# Option A — Resend (https://resend.com):
RESEND_API_KEY=""
# Option B — any SMTP server (used when RESEND_API_KEY is empty):
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
# With neither configured, emails are printed to the server log instead of being sent.

# ─── Child sponsorship ────────────────────────────────────────────────────
# Encrypts national ID numbers and health details. Generate with: openssl rand -base64 32
# Store a copy somewhere safe and offline. If it is lost, those fields cannot be recovered, even from backups.
DATA_ENCRYPTION_KEY=""
# Private bucket for child documents. Must NOT be public, and must be different from S3_BUCKET.
# Needs CORS allowing POST from your site. Uses the S3_ACCESS_KEY_ID user, which needs PutObject, GetObject and DeleteObject on it.
# Required in production; in development files go to .private-uploads.
S3_PRIVATE_BUCKET=""

# ─── Google Drive backups ─────────────────────────────────────────────────
# "oauth" for a personal Google account, "service_account" for a Workspace Shared Drive.
GOOGLE_AUTH_MODE="oauth"
# oauth only: from the OAuth client in Google Cloud. Redirect URI: <your site>/api/google/oauth
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
# service_account only: the JSON key, base64 encoded, and the Shared Drive folder ID.
GOOGLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_DRIVE_BACKUP_FOLDER_ID=""
# Protects the scheduled backup routes. Generate with: openssl rand -hex 24
CRON_SECRET=""
# Encrypts the nightly database files. Store a copy safely offline: without it, backups cannot be opened.
BACKUP_ENCRYPTION_PASSWORD=""

# ─── Bot protection (recommended) ─────────────────────────────────────────
# Free Cloudflare Turnstile keys add a human check to every public form. Leave empty to turn it off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
