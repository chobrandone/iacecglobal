# ─── Database ─────────────────────────────────────────────────────────────
# PostgreSQL connection string. On Vercel use the pooled URL from Vercel Postgres / Neon / Supabase.
# For local development you can run `npm run db:local` and use the URL it prints.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/iacec?schema=public"

# ─── Authentication (Auth.js) ─────────────────────────────────────────────
# A long random string. Generate one with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"
# Your public site address (used for canonical URLs, sitemap, emails).
NEXT_PUBLIC_SITE_URL="https://iacecglobal.com"

# ─── First administrator (created by `npm run db:seed`) ───────────────────
ADMIN_EMAIL="admin@iacecglobal.com"
ADMIN_PASSWORD="change-me-to-a-strong-password"
ADMIN_NAME="Administrator"

# ─── Image & file storage (S3-compatible) ─────────────────────────────────
# Leave S3_BUCKET empty in development to store uploads in public/uploads.
# Production (Vercel) needs one of: Cloudflare R2, AWS S3 or Supabase Storage (S3 API).
S3_BUCKET=""
S3_REGION="auto"
# Endpoint for R2 / Supabase, e.g. https://<account-id>.r2.cloudflarestorage.com  (leave empty for AWS S3)
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL that serves the bucket, e.g. https://media.iacecglobal.com  (no trailing slash)
S3_PUBLIC_URL=""

# ─── Email (form notifications and auto-replies) ──────────────────────────
# Sender address, e.g. "IACEC <no-reply@iacecglobal.com>" (the domain must be verified with your provider).
EMAIL_FROM="IACEC <no-reply@iacecglobal.com>"
# Option A — Resend (https://resend.com):
RESEND_API_KEY=""
# Option B — any SMTP server (used when RESEND_API_KEY is empty):
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
# With neither configured, emails are printed to the server log instead of being sent.
